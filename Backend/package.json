{
  "name": "taskforge",
  "productName": "TaskForge",
  "version": "1.0.0",
  "description": "TaskForge Command Center",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node --watch server.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.taskforge.app",
    "productName": "TaskForge",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "model/**/*",
      "server.js",
      "main.js",
      ".env",
      "package.json"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.2"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
